    "eas:preview": "npx eas-cli build --profile preview --platform all",
    "supabase:start": "supabase start"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
